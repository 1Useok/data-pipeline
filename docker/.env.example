# /data_db is backed by the Docker volume pipeline_smb_data.
# On Windows, run ../scripts/setup_smb_data_volume.ps1 before starting the stack.
# The script reuses the authenticated Z: mapping; no SMB password belongs here.

# KIS production API credentials
PROD_KIS_APP_KEY=
PROD_KIS_APP_SECRET=
PROD_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A full universe normally takes 3-4 hours at the enforced global rate limit.
KIS_TASK_TIMEOUT_HOURS=5
KIS_TASK_RETRIES=3
KIS_MAX_FAILED_COUNT=0
KIS_MAX_FAILED_RATIO=0
KIS_MAX_UNEXPECTED_NO_DATA_COUNT=1
KIS_MAX_UNEXPECTED_NO_DATA_RATIO=0
KIS_SILENT_SKIP_WARN_RATIO=0.05
